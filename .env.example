# ================================================================
# MyEchoMind runtime configuration.
# Copy this file to `.env` and adjust values for your environment.
# ================================================================

# -------- LLM provider (Anthropic-compatible) --------
# LLM_MODE=mock  : deterministic rule-based responses, no API key required.
# LLM_MODE=real  : call ANTHROPIC_BASE_URL with ANTHROPIC_API_KEY.
LLM_MODE=mock

ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Only needed when ANTHROPIC_API_KEY is org-scoped (not workspace-scoped).
# Leave empty for workspace-scoped keys. Sent as `anthropic-workspace-id` header.
ANTHROPIC_WORKSPACE_ID=

# DeepSeek uses the Anthropic-compatible endpoint:
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#   ANTHROPIC_MODEL=deepseek-chat

# -------- Embedding provider --------
# EMBEDDING_MODE=mock                  : hash-based pseudo vectors.
# EMBEDDING_MODE=sentence-transformers : load a local ST model (all-MiniLM-L6-v2 by default).
EMBEDDING_MODE=mock
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# -------- Redis (working memory + rate limits) --------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# -------- ChromaDB (RAG + episodic + user profile) --------
# CHROMA_MODE=http  : connect to the Docker ChromaDB service (default, requires
#                     only the lightweight `chromadb-client` package).
# CHROMA_MODE=local : use PersistentClient at CHROMA_PATH; requires the full
#                     `chromadb` package (needs MSVC build tools on Windows).
CHROMA_MODE=http
CHROMA_PATH=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Collection names
CHROMA_COLLECTION_KB=knowledge_base
CHROMA_COLLECTION_EPISODIC=episodic
CHROMA_COLLECTION_PROFILE=user_profile

# -------- App --------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# -------- Working memory & RAG --------
WORKING_MEMORY_MAX=20
WORKING_MEMORY_TTL=86400
CONVERSATION_SUMMARY_TTL=604800

RAG_TOPK=5
RAG_REWRITE_N=3
RAG_RERANK_ENABLED=true

# -------- Tool governance (MCP layer) --------
TOOL_CACHE_TTL=300
TOOL_CIRCUIT_FAIL_THRESHOLD=5
TOOL_CIRCUIT_COOLDOWN_SEC=60
TOOL_TIMEOUT_SEC=10

# -------- Monitor thresholds --------
MONITOR_SUCCESS_RATE_THRESHOLD=0.90
MONITOR_LATENCY_MS_THRESHOLD=3000
MONITOR_ANOMALY_ZSCORE=2.5
MONITOR_WINDOW_SIZE=200
MONITOR_MIN_SAMPLES=5
MONITOR_MAX_ROUTING_PENALTY=0.60

# -------- Paths --------
SKILLS_DIR=./skills
EVAL_BASELINE_PATH=./data/eval/baseline.json
LOGS_DIR=./logs
